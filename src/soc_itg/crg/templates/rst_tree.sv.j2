// Auto-generated by crg_gen v{{ gen.version }} from {{ gen.input_name }} (spec v{{ m.version }}) on {{ gen.date }} -- DO NOT EDIT
// Reset tree: async-assert/sync-release synchronizers with external HW source
// merge and optional SW reset (active-high CSR bit, ORed into async assert)
`timescale 1ns/1ps
module {{ m.module }}_rst_tree (
  // ---- input reset sources
{% for n in m.rt.rsts_in %}
  input  logic {{ n }},
{% endfor %}
  // ---- SW reset bits (from regmap, active-high assert)
{% for w in m.rt.sw_in %}
  input  logic [{{ w.width - 1 }}:0] {{ w.name }},
{% endfor %}
  // ---- clock domains
{% for n in m.rt.clks_in %}
  input  logic {{ n }},
{% endfor %}
{% if m.rt.mcp_domains %}
  // ---- MCP sequencer enables (to clk_tree gates)
{% for n in m.rt.mcp_en_out %}
  output logic {{ n }},
{% endfor %}
{% endif %}
  // ---- generated resets
{% for r in m.resets %}
  output logic {{ r.name }}{{ ',' if not loop.last }}
{% endfor %}
);
{% for r in m.resets %}
  wire {{ r.name }}_in;  // merged async source (low = asserted)
  wire {{ r.name }}_w;
{% endfor %}

{% for r in m.resets %}
  // {{ r.name }}: {{ r.type }} from {{ r.parent or '-' }}{% if r.hw_src %} + HW_SRC {{ r.hw_src }}{% endif %}{% if r.sw %} + SW reset ({{ r.sw_fq }}){% endif %} - {{ r.desc }}
  assign {{ r.name }}_in = {{ r.in_expr }};
{% if r.type == 'sync' %}
  crg_reset_sync {{ r.inst }} (
    .clk      ({{ r.clk_wire }}),
    .rst_n_in ({{ r.name }}_in),
    .rst_n_out({{ r.name }}_w)
  );
{% else %}
  assign {{ r.name }}_w = {{ r.name }}_in;
{% endif %}
{% endfor %}
{% for d in m.rt.mcp_domains %}

  // ---- MCP clock gating for '{{ d.clk }}' (margin {{ d.n }} cycles,
  //      128 assert-phase pulses; gate closes around reset transitions)
  crg_rst_mcp #(.MARGIN_CYCLES({{ d.n }})) u_mcp_{{ d.clk }} (
    .clk_free ({{ d.clk }}_free),
    .rst_n_src ({{ d.src_expr }}),
    .rst_n_sync({{ d.sync_expr }}),
    .clk_en    (en_{{ d.clk }})
  );
{% endfor %}

  // ---- output mapping
{% for r in m.resets %}
  assign {{ r.name }} = {{ r.name }}_w;
{% endfor %}
endmodule
