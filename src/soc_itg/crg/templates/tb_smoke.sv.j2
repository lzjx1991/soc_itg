// Auto-generated by crg_gen v{{ gen.version }} from {{ gen.input_name }} (spec v{{ m.version }}) on {{ gen.date }} -- DO NOT EDIT
// Smoke testbench: per-phase edge counting vs statically computed expectations,
// CSR readback, HW-enable behavior, SW reset assert/release, reset order.
// Prints TB_PASS / TB_FAIL.
`timescale 1ns/1ps
module tb_{{ m.module }};
  localparam integer WINDOW_NS = {{ m.tb.window_ns }};
  localparam integer TOL = {{ m.tb.tol }};

  // ---- stimulus --------------------------------------------------------
{% for p in m.clk_inputs %}
  logic {{ p.name }} = 1'b0;  // {{ p.freq }} MHz
  always #({{ p.half }}) {{ p.name }} = ~{{ p.name }};
{% endfor %}
  logic pclk = 1'b0;
  always #({{ m.tb.pclk_half }}) pclk = ~pclk;
  logic preset_n;  // APB domain reset (driven with the first input reset)
{% for p in m.rst_inputs %}
  logic {{ p.name }};
{% endfor %}
{% for p in m.ena_inputs %}
  logic {{ p.name }};  // HW enable
{% endfor %}
{% if m.has_mcp %}
  logic test_en = 1'b0;  // DFT bypass off in functional sim
{% endif %}
  logic psel, penable, pwrite;
  logic [{{ m.apb_addr_w - 1 }}:0] paddr;
  logic [31:0] pwdata, prdata;
  logic pready;
{% for c in m.exported_clocks %}
  logic {{ c.name }};
{% endfor %}
{% for c in m.internal_clocks %}
  wire {{ c.name }} = dut.u_clk_tree.{{ c.name }};  // internal clock: hierarchical ref
{% endfor %}
{% for r in m.exported_resets %}
  logic {{ r.name }};
{% endfor %}
{% for r in m.internal_resets %}
  wire {{ r.name }} = dut.u_rst_tree.{{ r.name }};  // internal reset: hierarchical ref
{% endfor %}

  {{ m.module }}_top #(.APB_ADDR_W({{ m.apb_addr_w }})) dut (
{% for p in m.clk_inputs %}
    .{{ p.name }}({{ p.name }}),
{% endfor %}
{% for p in m.rst_inputs %}
    .{{ p.name }}({{ p.name }}),
{% endfor %}
{% for p in m.ena_inputs %}
    .{{ p.name }}({{ p.name }}),
{% endfor %}
{% if m.has_mcp %}
    .test_en(test_en),
{% endif %}
    .pclk(pclk), .preset_n(preset_n),
    .psel(psel), .penable(penable), .pwrite(pwrite),
    .paddr(paddr), .pwdata(pwdata), .prdata(prdata), .pready(pready),
{% for c in m.exported_clocks %}
    .{{ c.name }}({{ c.name }}),
{% endfor %}
{% for r in m.exported_resets %}
    .{{ r.name }}({{ r.name }}){{ ',' if not loop.last }}
{% endfor %}
  );

  // ---- edge counters ----------------------------------------------------
{% for c in m.clocks %}
  integer cnt_{{ c.name }};
  always @(posedge {{ c.name }}) cnt_{{ c.name }} = cnt_{{ c.name }} + 1;
{% endfor %}

  // ---- reset rise timestamps --------------------------------------------
{% for r in m.resets %}
  real t_{{ r.name }};
  initial t_{{ r.name }} = 0.0;
  always @(posedge {{ r.name }}) t_{{ r.name }} = $realtime;
{% endfor %}

  // ---- APB driver --------------------------------------------------------
  task apb_wr(input [31:0] a, input [31:0] d);
    begin
      psel = 1; pwrite = 1; paddr = a[{{ m.apb_addr_w - 1 }}:0]; pwdata = d;
      @(posedge pclk);
      penable = 1;
      @(posedge pclk);
      #1;
      penable = 0; psel = 0; pwrite = 0;
    end
  endtask

  task apb_rd(input [31:0] a, output [31:0] d);
    begin
      psel = 1; pwrite = 0; paddr = a[{{ m.apb_addr_w - 1 }}:0];
      @(posedge pclk);
      penable = 1;
      @(posedge pclk);
      #1;
      d = prdata;
      penable = 0; psel = 0;
    end
  endtask

  task clear_counts;
    begin
{% for c in m.clocks %}
      cnt_{{ c.name }} = 0;
{% endfor %}
    end
  endtask

  // ---- main sequence -----------------------------------------------------
  integer errors;
  logic [31:0] rdata;

  initial begin
    errors = 0;
    psel = 0; penable = 0; pwrite = 0; paddr = '0; pwdata = '0;
{% for p in m.rst_inputs %}
    {{ p.name }} = 0;
{% endfor %}
    preset_n = 0;
{% for p in m.ena_inputs %}
    {{ p.name }} = 1'b1;  // HW enables on by default
{% endfor %}
    #200;
{% for p in m.rst_inputs %}
    {{ p.name }} = 1;
{% endfor %}
    preset_n = 1;
    #{{ m.tb.settle_ns }};  // settle: mux warm-up + reset sync + MCP sequencing
{% for ph in m.tb.phases %}

    // ---- phase: {{ ph.name }} ({{ ph.desc }})
{% if ph.kind == 'sw_rst' %}
{% for w in ph.writes %}
    apb_wr({{ w.addr }}, {{ w.value }});  // assert {{ w.reg }}
{% endfor %}
    #{{ m.tb.settle_ns }};
{% for r in ph.sw_resets %}
    if ({{ r }} !== 1'b0) begin
      errors = errors + 1;
      $display("FAIL  sw reset {{ r }} did not assert");
    end else
      $display("  ok  sw reset {{ r }} asserted");
{% endfor %}
{% for w in ph.writes %}
    apb_wr({{ w.addr }}, 32'h00000000);  // de-assert {{ w.reg }}
{% endfor %}
    #{{ m.tb.settle_ns }};
{% for r in ph.sw_resets %}
    if ({{ r }} !== 1'b1) begin
      errors = errors + 1;
      $display("FAIL  sw reset {{ r }} did not release");
    end else
      $display("  ok  sw reset {{ r }} released");
{% endfor %}
{% else %}
{% for w in ph.writes %}
    apb_wr({{ w.addr }}, {{ w.value }});  // {{ w.reg }}
{% endfor %}
{% for e in ph.ena %}
    {{ e[0] }} = 1'b{{ e[1] }};
{% endfor %}
    #{{ m.tb.settle_ns }};  // settle
    clear_counts;
    #WINDOW_NS;
{% for e in ph.expects %}
    if (cnt_{{ e.name }} < {{ e.count }} - TOL || cnt_{{ e.name }} > {{ e.count }} + TOL) begin
      errors = errors + 1;
      $display("FAIL  {{ e.name }} in {{ ph.name }}: got %0d expected %0d", cnt_{{ e.name }}, {{ e.count }});
    end else
      $display("  ok  {{ e.name }} in {{ ph.name }}: %0d edges", cnt_{{ e.name }});
{% endfor %}
{% for e in ph.ena_post %}
    {{ e[0] }} = 1'b{{ e[1] }};  // restore after measurement
{% endfor %}
{% endif %}
{% endfor %}

    // ---- CSR readback
{% for rb in m.tb.readbacks %}
    apb_rd({{ rb.addr }}, rdata);
    if (rdata !== {{ rb.expect }}) begin
      errors = errors + 1;
      $display("FAIL  readback {{ rb.reg }}: got 0x%08h expected {{ rb.expect }}", rdata);
    end else
      $display("  ok  readback {{ rb.reg }} = {{ rb.expect }}");
{% endfor %}

    // ---- reset release
{% for r in m.resets %}
    if (t_{{ r.name }} == 0.0) begin
      errors = errors + 1;
      $display("FAIL  reset {{ r.name }} never released");
    end
{% endfor %}
{% for p in m.reset_pairs %}
    if (t_{{ p.child }} < t_{{ p.parent }}) begin
      errors = errors + 1;
      $display("FAIL  {{ p.child }} released before {{ p.parent }}");
    end else
      $display("  ok  {{ p.child }} released after {{ p.parent }}");
{% endfor %}

    if (errors == 0)
      $display("TB_PASS {{ m.module }}");
    else begin
      $display("TB_FAIL {{ m.module }}: %0d error(s)", errors);
      $fatal(1);
    end
    $finish;
  end
endmodule
