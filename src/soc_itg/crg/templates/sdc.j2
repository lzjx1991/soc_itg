# Auto-generated by crg_gen v{{ gen.version }} from {{ gen.input_name }} (spec v{{ m.version }}) on {{ gen.date }} -- DO NOT EDIT
# Constraints for {{ m.module }}_top

# ---- input clocks
{% for c in m.sdc.input_periods %}
create_clock -name {{ c.name }} -period {{ c.period }} [get_ports {{ c.name }}]
{% endfor %}
{% if m.sdc.async_group %}

# all input clocks are assumed mutually asynchronous
set_clock_groups -asynchronous{% for c in m.sdc.input_periods %} -group [get_clocks {{ c.name }}]{% endfor %}

{% endif %}
# ---- generated clocks (mux outputs carry one definition per branch)
{% for c in m.sdc.clocks %}
{% if c.sw_ratio %}
# NOTE: {{ c.port }} divider ratio is SW-configurable ({{ c.ratio }}..{{ c.ratio_max }});
# constraints below use the reset value {{ c.ratio }}. Re-constrain with the
# minimum ratio for signoff timing (worst-case frequency).
{% endif %}
create_generated_clock -name {{ c.name }} -source {{ c.source }} -divide_by {{ c.div }} {{ c.target }}{{ ' -add' if c.add }}
{% endfor %}
{% for g in m.sdc.excl %}

# glitch-free mux: branches are mutually exclusive
set_clock_groups -logically_exclusive{% for c in g.clocks %} -group [get_clocks {{ c }}]{% endfor %}

{% endfor %}
# ---- asynchronous control inputs
{% for p in m.sdc.false_path_ports %}
set_false_path -from [get_ports {{ p }}]
{% endfor %}
{% for r in m.sdc.mcp_rsts %}

# MCP clock gating on '{{ r.clk }}' (N={{ r.n }}): the gate reopens only
# >= {{ r.n }}+2 cycles after this reset releases, so recovery/removal
# analysis is replaced by a distribution budget: the release transition
# must reach every endpoint within {{ r.budget }} ns (= {{ r.n }} x domain
# period). A violation here is real: the reset tree is slower than the
# MCP window.
set_max_delay {{ r.budget }} -from {% if r.exported %}[get_ports {{ r.name }}]{% else %}[get_pins u_rst_tree/{{ r.name }}]{% endif %}
{% endfor %}
